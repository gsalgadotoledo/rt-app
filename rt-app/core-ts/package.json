{
  "name": "@gsalgadotoledo/rt-app-core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "rt-app.module.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "npm run build && tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext test/types.ts && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsalgadotoledo/rt-app.git",
    "directory": "rt-app/core-ts"
  },
  "engines": {
    "node": ">=22.14"
  }
}
