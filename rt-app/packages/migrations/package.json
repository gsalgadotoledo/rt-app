{
  "name": "@gsalgadotoledo/rt-app-migrations",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@gsalgadotoledo/rt-app-contracts": "0.1.0",
    "@gsalgadotoledo/rt-app-nosql": "0.1.0",
    "umzug": "3.8.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@gsalgadotoledo/rt-app-dynamodb": "0.1.0",
    "@gsalgadotoledo/rt-app-json": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsalgadotoledo/rt-app.git",
    "directory": "rt-app/packages/migrations"
  },
  "engines": {
    "node": ">=22.14"
  },
  "files": [
    "dist",
    "src",
    "ui",
    "backend",
    "bin",
    "templates",
    "scripts",
    "infra",
    "*.mjs",
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.json",
    "*.css",
    "*.html",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "description": "Module-owned, engine-agnostic migrations and seeds for RT-App, built on Umzug.",
  "peerDependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  }
}
