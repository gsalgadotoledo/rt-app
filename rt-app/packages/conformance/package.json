{
  "name": "@gsalgadotoledo/rt-app-conformance",
  "version": "0.3.0",
  "description": "Language-neutral contracts for RT-App modules: YAML/JSON cases with inputs, outputs and errors, an HTTP host protocol and a runner that checks every language implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rta-contract": "./bin/rta-contract.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.0.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsalgadotoledo/rt-app.git",
    "directory": "rt-app/packages/conformance"
  },
  "engines": {
    "node": ">=22.14"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
