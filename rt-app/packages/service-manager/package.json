{
  "name": "@gsalgadotoledo/rt-app-service-manager",
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.mjs",
  "exports": {
    "./client": "./client.mjs",
    "./ui": "./ui/ServiceManager.tsx",
    "./cli": "./cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@gsalgadotoledo/rt-app-config": "0.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@gsalgadotoledo/rt-app-create": "0.2.1",
    "@gsalgadotoledo/rt-app-admin-ui": "0.2.1",
    "@gsalgadotoledo/rt-app-deployments": "0.2.1",
    "@gsalgadotoledo/rt-app-deploy": "0.2.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsalgadotoledo/rt-app.git",
    "directory": "rt-app/packages/service-manager"
  },
  "engines": {
    "node": ">=22.14"
  },
  "files": [
    "dist",
    "src",
    "ui",
    "backend",
    "bin",
    "templates",
    "scripts",
    "infra",
    "*.mjs",
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.json",
    "*.css",
    "*.html",
    "AGENTS.md",
    "README.md",
    "electron",
    "native/src",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "LICENSE"
  ]
}
