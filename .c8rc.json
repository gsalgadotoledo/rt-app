{
  "all": true,
  "include": [
    "rt-app/packages/*/dist/**/*.js",
    "rt-app/dist/**/*.js",
    "rt-app/admin/dist/backend/**/*.js",
    "rt-app/installer/dist/**/*.js",
    "rt-app/core-ts/dist/**/*.js"
  ],
  "exclude": [
    "**/service-manager/**",
    "**/core-ts/dist/types.js",
    "**/core-ts/src/types.ts",
    "**/auth/dist/provider.js"
  ],
  "exclude-after-remap": false,
  "reporter": ["text", "html", "lcov", "json-summary"],
  "reports-dir": "coverage",
  "temp-directory": ".coverage-tmp",
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "branches": 80,
  "functions": 80
}
