{
  "name": "@gsalgadotoledo/rt-app-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@gsalgadotoledo/rt-app-auth": "0.1.0",
    "@gsalgadotoledo/rt-app-config": "0.1.0",
    "@gsalgadotoledo/rt-app-contracts": "0.1.0",
    "@gsalgadotoledo/rt-app-dynamodb": "0.1.0",
    "@gsalgadotoledo/rt-app-framework": "0.1.0",
    "@gsalgadotoledo/rt-app-json": "0.1.0",
    "@gsalgadotoledo/rt-app-mail-local": "0.1.0",
    "@gsalgadotoledo/rt-app-migrations": "0.1.0",
    "@gsalgadotoledo/rt-app-myadmin": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
