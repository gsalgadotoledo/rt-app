{
  "name": "hello-world-rt-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/packages/*",
    "packages/*"
  ],
  "scripts": {
    "build": "rta build",
    "test": "npm run build && npm test --workspaces --if-present",
    "check:architecture": "rta check",
    "dev": "rta dev",
    "start": "rta dev",
    "lambda:build": "node apps/lambda-ts/build.mjs",
    "migrate": "node apps/server/dist/migrate.js",
    "seed": "node apps/server/dist/seed.js",
    "dev:dynamo": "RT_APP_MODE=dynamodb-local npm run dev",
    "setup": "rta install",
    "setup:terminal": "rta setup-terminal",
    "cli": "rta module",
    "rta": "rta",
    "mail": "rta mail",
    "desktop": "rta desktop",
    "services": "rta services",
    "cloud": "rta cloud",
    "mcp": "node apps/mcp/index.mjs",
    "admin": "rta admin",
    "deploy": "rta deploy"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=22.14"
  },
  "type": "module",
  "rtApp": {
    "backend": "@gsalgadotoledo/rt-app-server",
    "admin": "@gsalgadotoledo/rt-app-myadmin",
    "spa": "@gsalgadotoledo/rt-app-spa",
    "ssr": "@gsalgadotoledo/rt-app-ssr"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "dependencies": {
    "@gsalgadotoledo/rt-app-cli": "0.2.0",
    "@gsalgadotoledo/rt-app-framework": "0.2.0",
    "@gsalgadotoledo/rt-app-core": "0.2.0",
    "@gsalgadotoledo/rt-app-myadmin": "0.2.0",
    "@gsalgadotoledo/rt-app-config": "0.2.0",
    "@gsalgadotoledo/rt-app-infra": "0.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0"
  }
}
