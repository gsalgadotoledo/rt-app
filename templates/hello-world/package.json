{
  "name": "hello-world-rt-app",
  "private": true,
  "workspaces": [
    "rt-app",
    "rt-app/packages/*",
    "rt-app/admin",
    "apps/*",
    "rt-app/installer",
    "rt-app/cli",
    "apps/*/packages/*",
    "rt-app/packages/*/packages/*",
    "packages/*",
    "rt-app/core-ts"
  ],
  "scripts": {
    "build": "node rt-app/scripts/workspaces.mjs build",
    "test": "npm run build && npm run test --workspaces --if-present",
    "check:architecture": "node rt-app/scripts/workspaces.mjs check",
    "dev": "rta dev",
    "start": "rta dev",
    "lambda:build": "node apps/lambda-ts/build.mjs",
    "migrate": "node apps/server/dist/migrate.js",
    "seed": "node apps/server/dist/seed.js",
    "dev:dynamo": "RT_APP_MODE=dynamodb-local npm run dev",
    "test:dynamo": "npm run test:integration -w @gsalgadotoledo/rt-app-dynamodb",
    "setup": "rta install",
    "setup:terminal": "npm run build && node rt-app/cli/dist/index.js",
    "cli": "node rt-app/cli/dist/modules.js",
    "rta": "rta",
    "mail": "rta mail",
    "desktop": "rta desktop",
    "services": "rta services",
    "desktop:package": "npm run package -w @gsalgadotoledo/rt-app-service-manager",
    "generator:link": "npm link --workspace @gsalgadotoledo/rt-app-create --ignore-scripts",
    "generator:pack": "node rt-app/packages/create/scripts/prepare.mjs && mkdir -p .rt-app/npm && npm pack -w @gsalgadotoledo/rt-app-create --pack-destination .rt-app/npm",
    "core:pack": "npm run build -w @gsalgadotoledo/rt-app-core && mkdir -p .rt-app/npm && npm pack -w @gsalgadotoledo/rt-app-core --pack-destination .rt-app/npm",
    "cloud": "rta cloud",
    "mcp": "node apps/mcp/index.mjs"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "rtApp": {
    "backend": "@gsalgadotoledo/rt-app-server",
    "admin": "@gsalgadotoledo/rt-app-myadmin",
    "spa": "@gsalgadotoledo/rt-app-spa",
    "ssr": "@gsalgadotoledo/rt-app-ssr"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
